{
  "name": "@arcaneorion/dsh-model-selector-search",
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./package.json": "./package.json"
  },
  "description": "DSH session model selector with search and reasoning-effort pane: shadows the native conversation.input.model seat (independent cordis client plugin).",
  "license": "MIT",
  "author": "arcanexis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArcaneOrion/dsh-model-selector-search.git"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "model-selector",
    "ui"
  ],
  "files": [
    "src",
    "cordis.patch.yml",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": ["slots", "connection"],
      "platform": "web"
    }
  }
}
